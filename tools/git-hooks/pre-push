#!/bin/sh
# Pre-push hook (D-53): blocks the push unless every preset passes on macOS arm64 and in the
# Linux arm64 container. Pushes that change only documentation (docs/, specs/, *.md) run only the
# name check. Installed by tools/install-git-hooks.sh. In an emergency, `git push --no-verify`
# skips it; write the reason in the next commit message.
set -u
repository_root=$(git rev-parse --show-toplevel)
zero_object="0000000000000000000000000000000000000000"

changed_files=""
while read -r local_reference local_object remote_reference remote_object; do
    : "$local_reference" "$remote_reference"
    if [ "$local_object" = "$zero_object" ]; then
        continue # branch deletion: nothing to check
    fi
    if [ "$remote_object" = "$zero_object" ]; then
        # New branch: compare with what the remote already has.
        range_files=$(git log --name-only --format= "$local_object" --not --remotes)
    else
        range_files=$(git diff --name-only "$remote_object" "$local_object")
    fi
    changed_files="$changed_files
$range_files"
done

changed_files=$(printf '%s\n' "$changed_files" | sed '/^$/d' | sort -u)
if [ -z "$changed_files" ]; then
    exit 0
fi

non_documentation=$(printf '%s\n' "$changed_files" | grep -Ev '^(docs/|specs/)|\.md$' || true)
if [ -z "$non_documentation" ]; then
    echo "pre-push: documentation-only change; running the name check"
    exec "$repository_root/tools/local-check.sh" --documentation-only
fi

echo "pre-push: checking every preset on macOS arm64 and in the Linux arm64 container (D-53)"
if "$repository_root/tools/local-check.sh"; then
    exit 0
fi
echo "pre-push: push blocked. Fix the failures above (log: build/local-check.log)."
exit 1
